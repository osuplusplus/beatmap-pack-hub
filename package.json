{
  "name": "beatmap-pack-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:link": "vitest run test/link",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply beatmap-pack-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply beatmap-pack-hub --remote"
  },
  "dependencies": {
    "hono": "^4.9.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.9.2",
    "undici": "^7.29.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  }
}
